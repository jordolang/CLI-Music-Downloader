#!/bin/bash
# Download one song into ~/Music/<Artist>/<Title>.mp3 with metadata, artwork and lyrics.
#   download_music "Evanescence - Bring Me to Life"
#   download_music --artist Creed --title "One Last Breath"
set -euo pipefail
PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="$PROJECT_DIR/.venv/bin/python"
[[ -x "$PYTHON" ]] || PYTHON="python3"
export PYTHONPATH="$PROJECT_DIR${PYTHONPATH:+:$PYTHONPATH}"
has_option=false
for arg in "$@"; do [[ "$arg" == -* ]] && has_option=true; done
if [[ $# -gt 1 && $has_option == false ]]; then
    # download_music The Beatles Hey Jude  →  one search term
    set -- "$*"
fi
exec "$PYTHON" -m cli_music_downloader download "$@"
